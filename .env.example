# Copy to .env and fill in. .env is gitignored.
# Fireworks is required; OpenAI / Anthropic are optional (those models are skipped if unset).
FIREWORKS_API_KEY=
# Only needed by experiments/scion (deployments) and the routers that serve a tuned LoRA.
FIREWORKS_ACCOUNT_ID=
# Only needed by experiments/scion (gated datasets).
HF_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
